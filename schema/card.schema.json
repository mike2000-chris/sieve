{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sieve.project/schema/card.schema.json",
  "title": "SIEVE hypothesis card",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "title", "claim", "domain", "signature_class", "observable", "timescale", "mechanism", "status", "provenance"],
  "$defs": {
    "judged": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "prompt_version", "date", "by"],
      "description": "Who produced a gate or scoring output: model, prompt file, operator and date (CLAUDE.md rule 7)",
      "properties": {
        "model": { "type": "string" },
        "prompt_version": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "by": { "type": "string" }
      }
    }
  },
  "properties": {
    "id": { "type": "string", "pattern": "^(SIEVE|BASE)-[0-9]{4}$", "description": "SIEVE-NNNN for catalogue cards; BASE-NNNN for literature-baseline cards in evaluation/baseline/cards/ (never in catalogue/cards/)" },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 10, "maxLength": 160 },
    "claim": { "type": "string", "minLength": 20, "description": "One falsifiable sentence" },
    "domain": { "enum": ["biosignature", "technosignature", "solar_system_insitu"] },
    "signature_class": { "enum": ["atmospheric_chemistry", "surface_albedo", "thermal_waste_heat", "artificial_structure_geometry", "em_transmission", "temporal_behaviour", "population_statistics", "insitu_composition"] },
    "observable": { "enum": ["photometry", "spectroscopy", "astrometry", "time_series", "polarimetry", "radio", "imaging", "mass_spectrometry", "population_statistic", "spectral_excess"] },
    "timescale": { "enum": ["snapshot", "days", "years", "decades"] },
    "mechanism": { "type": "string", "minLength": 20, "description": "Why life or technology produces the signature, with an order-of-magnitude estimate" },
    "data_requirements": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "wavelength_um": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "spectral_resolution": { "type": ["string", "number"] },
        "cadence": { "type": "string" },
        "depth": { "type": "string" },
        "sample": { "type": "string" }
      }
    },
    "candidate_archives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "access"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "access": { "type": "string" },
          "licence": { "type": "string" },
          "volume_estimate": { "type": "string" }
        }
      }
    },
    "method": { "type": "string" },
    "confounders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "exclusion"],
        "additionalProperties": false,
        "properties": { "name": { "type": "string" }, "exclusion": { "type": "string" } }
      }
    },
    "novelty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["unchecked", "open", "partly_done", "done"] },
        "closest_prior": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["bibcode", "relation"],
            "additionalProperties": false,
            "properties": {
              "bibcode": { "type": "string", "pattern": "^[0-9]{4}[A-Za-z0-9&.]{5}[A-Za-z0-9.]{9}[A-Z]$", "description": "19-character ADS bibcode that resolved through the ADS API" },
              "register_id": { "type": "string" },
              "relation": { "type": "string" }
            }
          }
        },
        "confidence": { "enum": ["low", "medium", "high"] },
        "rationale": { "type": "string" },
        "what_would_make_it_open": { "type": "string" },
        "queries_run": { "type": "array", "items": { "type": "string" } },
        "judged": { "$ref": "#/$defs/judged", "description": "Provenance of the G2 verdict; written by pipeline/cards.py set_novelty" },
        "audited_by_human": { "type": "boolean" }
      }
    },
    "physics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "judged"],
      "description": "Gate G1 output (physics plausibility); written by pipeline/gates/g1.py through pipeline/cards.py. The full result with the arithmetic stays in the gate log.",
      "properties": {
        "verdict": { "enum": ["pass", "revise", "fail"] },
        "rationale": { "type": "string" },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "description": "Result per G1 check; the notes are in the gate log",
          "properties": {
            "energy_budget": { "enum": ["ok", "concern", "fail", "uncertain"] },
            "observability": { "enum": ["ok", "concern", "fail", "uncertain"] },
            "internal_consistency": { "enum": ["ok", "concern", "fail", "uncertain"] },
            "forbidden_physics": { "enum": ["ok", "concern", "fail", "uncertain"] }
          }
        },
        "revision_hints": { "type": "array", "items": { "type": "string" }, "description": "What to change before the card is judged again; empty unless the verdict is revise" },
        "judged": { "$ref": "#/$defs/judged" },
        "audited_by_human": { "type": "boolean" }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "novelty": { "type": "integer", "minimum": 0, "maximum": 3 },
        "feasibility": { "type": "integer", "minimum": 0, "maximum": 3 },
        "information_value": { "type": "integer", "minimum": 0, "maximum": 3 },
        "confounder_robustness": { "type": "integer", "minimum": 0, "maximum": 3 },
        "cost_inverted": { "type": "integer", "minimum": 0, "maximum": 3 },
        "total": { "type": "integer", "minimum": 0, "maximum": 15 },
        "estimated_human_hours": { "type": "number", "minimum": 0 },
        "estimated_compute_eur": { "type": "number", "minimum": 0 },
        "estimated_llm_eur": { "type": "number", "minimum": 0 },
        "quick": { "type": "boolean", "description": "feasibility = 3 and estimated_human_hours < 10; pipeline/converge.py requires min_quick_cards" },
        "ambitious": { "type": "boolean", "description": "feasibility <= 1 or estimated_human_hours > 25; pipeline/converge.py caps these at max_ambitious_cards" },
        "dominant_confounder": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "Normalised snake_case label; pipeline/converge.py selects no two cards with the same label" },
        "scored_by": { "enum": ["llm", "human", "both"] },
        "flags": { "type": "array", "items": { "type": "string" }, "description": "Missing or inconsistent gate outputs the scorer had to work around" },
        "one_line_rationale": { "type": "string" },
        "judged": { "$ref": "#/$defs/judged", "description": "Provenance of the scoring call (prompts/score-v*.md)" }
      }
    },
    "null_result_value": { "type": "string" },
    "status": { "enum": ["raw", "gated", "parked", "selected", "preregistered", "executed", "reported"] },
    "anomaly_level": { "type": ["integer", "null"], "minimum": 0, "maximum": 5, "description": "Credibility ladder level; only the owner sets values above 1" },
    "parked_reason": { "type": ["string", "null"] },
    "preregistration": { "type": ["string", "null"] },
    "report": { "type": ["string", "null"] },
    "provenance": {
      "type": "object",
      "required": ["generator_model", "prompt_version", "operator", "created"],
      "additionalProperties": false,
      "properties": {
        "generator_model": { "type": "string" },
        "prompt_version": { "type": "string" },
        "operator": { "enum": ["cross_archive_transfer", "inversion", "population_statistics", "coincidence", "earth_as_template", "negative_space", "cross_disciplinary_analogy", "pipeline_shadow", "human", "manual"] },
        "taxonomy_cell": { "type": "string" },
        "parent_card": { "type": ["string", "null"] },
        "created": { "type": "string", "format": "date" },
        "edited_by_human": { "type": "boolean" },
        "source_bibcodes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[0-9]{4}[A-Za-z0-9&.]{5}[A-Za-z0-9.]{9}[A-Z]$" },
          "description": "Baseline cards only: ADS-resolved bibcodes of the publication(s) the idea was transcribed from. Provenance, not novelty evidence; pipeline/cards.py blind_card removes the provenance block before gate prompts."
        },
        "transcribed_by": { "type": "string", "description": "Baseline cards only: model or person who transcribed the published idea into card form" }
      }
    }
  }
}
